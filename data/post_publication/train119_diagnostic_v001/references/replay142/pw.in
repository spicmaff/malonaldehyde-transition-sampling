  calculation = 'scf',
  restart_mode = 'from_scratch',
  prefix = 'diag119_replay142',
  pseudo_dir = './PSEUDO',
  outdir = './tmp',
  tprnfor = .true.,
  tstress = .false.,
  disk_io = 'low',
  verbosity = 'high',

  "research_question": "How do a-priori capped optimization budgets 2000 versus 8000 affect fixed Train60 regional errors and within-seed model ranking?",
  "baseline_status": "Existing five fixed-seed pairs at 2000 iterations, previously evaluated on Audit21; retrospective baseline, not new blinded data",
  "hypotheses": {
    "H1": "Larger main-step limit may improve, worsen or leave regional errors unchanged.",
    "H2": "Within-seed Basin/Targeted ranking may change.",
    "H3": "Basin/transition regional differences may depend on optimization budget.",
    "H4": "An 8000 cap may or may not meet the implementation stopping rule."
  },
  "primary_endpoint": {
    "name": "paired_difference_in_differences_transition_force_RMSE",
    "formula": "(targeted8000 - basin8000) - (targeted2000 - basin2000)",
    "unit": "eV/angstrom",
    "report": "All five signed differences, median, mean, range; no confirmatory p-value or selection"
  },
  "secondary_endpoints": [
    "lower_endpoint_barrier_abs_error_meV",
    "basin12_force_component_RMSE_eV_A",

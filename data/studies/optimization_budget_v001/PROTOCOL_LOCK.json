    "neb7_interior_centered_energy_RMSE_eV",
    "per_model_budget_changes",
    "training_objective_trace_and_stopping_reason",
    "signed_relative_profile_residuals"
  ],
  "metric_definitions": {
    "barrier": "abs((max(model NEB9 E)-min(model endpoint E)) - (max(PBE NEB9 E)-min(PBE endpoint E)))*1000",
    "transition_force": "sqrt(sum Cartesian force squared differences / 81), exactly three reference images with |qPT|<=0.15 A",
    "qPT": "distance(O atom1,H atom2)-distance(O atom8,H atom2)",
    "basin_force": "sqrt(sum errors squared / (12*27))",
    "interior_force": "sqrt(sum errors squared / (7*27))",
    "interior_energy": "RMS of seven energy errors after subtracting their mean; eV"
  },

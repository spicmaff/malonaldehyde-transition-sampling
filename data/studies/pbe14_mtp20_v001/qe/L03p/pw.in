&CONTROL
  calculation = 'scf',
  restart_mode = 'from_scratch',
  prefix = 'pval_L03p',
  pseudo_dir = './PSEUDO',
  outdir = './tmp',
  tprnfor = .true.,
  tstress = .false.,
  disk_io = 'low',
  verbosity = 'high',
/
&SYSTEM
  ibrav = 0,
  nat = 9,
  ntyp = 3,
  ecutwfc = 80,
  ecutrho = 960,
  occupations = 'fixed',
  input_dft = 'PBE',
  tot_charge = 0,
  nspin = 1,
  nosym = .true.,
  noinv = .true.,
/
&ELECTRONS
  conv_thr = 1.0d-10,
  electron_maxstep = 200,
  mixing_mode = 'plain',
  mixing_beta = 0.30,
  diagonalization = 'david',
/
